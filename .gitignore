# ============================================================
# CodeSphere .gitignore  (place at the repository root)
# ============================================================

# ---- Secrets: NEVER commit these -------------------------------------------
# .env holds your JWT_SECRET and database password.
.env
.env.*
.env.example
!.env.example
application-local.yml
application-local.properties
application-secrets.yml
*.pem
*.key
*.p12
*.jks

# ---- Backend: Java / Maven build output -------------------------------------
target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
HELP.md

# ---- Backend: runtime data --------------------------------------------------
# Files users upload are written here (STORAGE_LOCAL_PATH, default ./uploads).
uploads/
*.log
logs/

# ---- Frontend: Node / Vite --------------------------------------------------
node_modules/
dist/
.vite/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# ---- IDEs and editors -------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/
.classpath
.project
.settings/
.factorypath
.apt_generated/
.springBeans
*.swp
*.swo
*~

# ---- Operating system junk --------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
